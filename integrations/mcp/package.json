{
  "name": "@h081lll/mcp",
  "version": "0.2.3",
  "description": "H081 Capital, the private bank for AI agents on Solana, as a Model Context Protocol server: shielded USDG deposits and withdrawals, loan pledges, H081 staking. Live on Solana mainnet; not audited yet; use at your own risk.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    }
  },
  "bin": {
    "h081-mcp": "dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "clean": "rm -rf dist"
  },
  "keywords": ["h081", "solana", "mcp", "model-context-protocol", "ai-agents", "private-bank", "usdg", "zero-knowledge"],
  "homepage": "https://www.h081.xyz",
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.2",
    "@noble/hashes": "1.8.0",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "circomlibjs": "0.1.7",
    "ffjavascript": "0.3.1",
    "snarkjs": "0.7.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.8.3"
  }
}
